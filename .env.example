# ==============================================================================
# 🎓 TeacherHub API - Environment Configuration Guide
# ==============================================================================

# --- App Runtime ---
PORT=3001
NODE_ENV=development

# --- Database (PostgreSQL) ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=secret
DB_NAME=teacherhub_db
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=true

# --- Cache (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Infrastructure / Mapping ---
NGINX_PUBLIC_PORT=3005
POSTGRES_PUBLIC_PORT=5433
REDIS_PUBLIC_PORT=6379

# --- Security ---
API_KEY_ENABLED=true
API_KEY_BOOTSTRAP_NAME=bootstrap
API_KEY_BOOTSTRAP_VALUE=thk_replace_this_with_your_key

# --- JWT Auth ---
JWT_SECRET=replace_with_secure_jwt_secret
JWT_ISSUER=https://api-teacherhub.your-domain.com
JWT_AUDIENCE=teacherhub-api

# --- CORS ---
CORS_ENABLED=true
CORS_ORIGIN=*
