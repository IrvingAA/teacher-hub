{
  "name": "teacherhub-api",
  "version": "1.0.0",
  "description": "TeacherHub Api - Backend for technical tests",
  "main": "dist/server.js",
  "type": "commonjs",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "prebuild": "npx rimraf dist",
    "build": "tsc",
    "start": "node dist/server.js",
    "iconify:sync": "node scripts/sync-iconify.cjs",
    "docs:generate": "NODE_ENV=development node -r ts-node/register/transpile-only scripts/generate-openapi.cjs",
    "db:migrate": "node -r ts-node/register ./node_modules/typeorm/cli.js migration:run -d src/config/database.pg.ts",
    "db:migrate:revert": "node -r ts-node/register ./node_modules/typeorm/cli.js migration:revert -d src/config/database.pg.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "NODE_ENV=test jest --runInBand --forceExit",
    "test:coverage": "NODE_ENV=test jest --coverage --runInBand --forceExit",
    "test:watch": "NODE_ENV=test jest --watch"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "iconify-icon": "^2.3.0",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28",
    "ua-parser-js": "^2.0.9",
    "xss": "^1.0.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.3",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-util": "^29.7.0",
    "rimraf": "^6.1.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
